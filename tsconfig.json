{
  "compilerOptions": {
    "lib": [
      "es5",
      "es2018",
      "dom",
      "WebWorker"
    ],
    "target": "es2018",
    "module": "es6",
    "rootDir": "./src",
    "outDir": "./dist",
    "inlineSourceMap": true,
    "inlineSources": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  }
}

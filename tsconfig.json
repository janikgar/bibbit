{
  "compilerOptions": {
    "lib": [
      "es5",
      "es2018",
      "dom",
      "WebWorker"
    ],
    "target": "es2018",
    "module": "preserve",
    "moduleResolution": "bundler",
    "rootDir": "./src",
    "outDir": "./dist",
    "inlineSourceMap": true,
    "inlineSources": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "@types/node"
    ]
  }
}
